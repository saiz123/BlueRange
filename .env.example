# ── BlueRange Configuration ──────────────────────────────────────────────────
# Copy this file to .env and edit before starting.
# docker compose up -d will auto-load .env

# Server bind address (default: all interfaces, port 8080)
ADDR=:8080

# Data directory — where SQLite database is stored
# The ./data volume mount in docker-compose.yml maps here
DATA_DIR=/app/data

# Labs directory — where lab YAML + evidence files live
LABS_DIR=/app/labs

# Web asset directories (only change if you mount custom assets)
STATIC_DIR=/app/web/static
TMPL_DIR=/app/web/templates

# ── Admin account (created on first boot if it doesn't exist) ────────────────
# CHANGE THESE before first run. The password is argon2id-hashed at startup.
ADMIN_USER=admin
ADMIN_PASS=changeme

# ── Optional: External threat intel (off by default) ────────────────────────
# Uncomment and fill in API keys to replace the local simulated enrichment service.
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=

# ── Optional: Wazuh integration (off by default) ────────────────────────────
# WAZUH_URL=https://wazuh.your-domain.internal
# WAZUH_API_USER=
# WAZUH_API_PASS=
# WAZUH_VERIFY_TLS=true
